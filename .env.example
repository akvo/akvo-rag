# ==============================================================================
# AKVO-RAG UNIFIED CONTAINER ENVIRONMENT CONFIGURATION (OPTION C)
# ==============================================================================

# Application Environment & Security
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (Default: OpenAI)
CHAT_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# Alternative AI Providers (Optional)
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:7b
# DASH_SCOPE_API_KEY=your-dashscope-api-key

# PostgreSQL 17 Configuration (Unified Datastore)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=akvo_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/akvo_rag

# Redis 7 Configuration (Request-Reply RPC & Async Queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ChromaDB Vector Store Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001
IS_PERSISTENT=TRUE
PERSIST_DIRECTORY=/chroma/chroma
ANONYMIZED_TELEMETRY=FALSE

# MinIO S3 Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents

# Vector Microservice (vector-kb-mcp) Settings
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIM=1536

# Core Backend Gateway (backend) Settings
MCP_CONFIG_PATH=/app/mcp_config.json

# Email (SMTP) & Password Reset Settings
SMTP_HOST=akvomail.org
SMTP_PORT=465
SMTP_USER=noreply@akvomail.org
SMTP_PASS=your-smtp-password
SMTP_USE_TLS=true
WEBDOMAIN=127.0.0.1.nip.io
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Frontend & Public Service Port Mappings
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_BACKEND_URL=http://backend:8000